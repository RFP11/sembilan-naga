{
  "name": "@dnd/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:create": "tsx --env-file-if-exists=../../.env src/db/cli.ts create",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/cli.ts migrate",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/cli.ts seed",
    "db:setup": "tsx --env-file-if-exists=../../.env src/db/cli.ts setup",
    "db:reset": "tsx --env-file-if-exists=../../.env src/db/cli.ts reset",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@dnd/character": "workspace:*",
    "@dnd/contracts": "workspace:*",
    "@dnd/data": "workspace:*",
    "@dnd/rules": "workspace:*",
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^8.2.0",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "postgres": "^3.4.7",
    "socket.io": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
