# Server
HOST=127.0.0.1
PORT=4000
# Local Postgres. URL-encode special characters in the password (# -> %23, @ -> %40).
# Using docker-compose's Postgres instead? Use postgres://dnd:dnd@localhost:5433/dnd
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/dnd

# Origin you open in the browser; Google redirects back to <PUBLIC_URL>/api/auth/google/callback
PUBLIC_URL=http://localhost:5173

# Google login (optional in development): create an OAuth client ID in Google Cloud Console
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Development only: log in as a seed user without Google. Ignored when NODE_ENV=production.
DEV_LOGIN=true

# The campaign promoted on the public page; registrations stay closed while empty.
# This id is the seeded "Serpih Langit" campaign (development). In production, create the
# campaign in the app while logged in as the DM, then use its id.
PROMO_CAMPAIGN_ID=00000000-0000-4000-8000-000000000102
# MinIO: private bucket for character sheets and map images. Written by scripts/minio-setup.sh.
# While these are empty, registrations are closed and the map has no images.
# S3_ENDPOINT=https://s3.rfp11.com
# S3_BUCKET=dnd-serpih
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Production only: folder with the web build, served by the server
# WEB_DIST=../web/dist
